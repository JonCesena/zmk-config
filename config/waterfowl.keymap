/*
 * Waterfowl - left half as a Clip Studio Paint controller
 *
 * Two layers: CSP and ANIM. Z toggles between them.
 * Each layer lists 40 keys: 4 rows of (5 left keys, 5 right keys).
 * The right half is unused, so its keys are &none.
 *
 * Sensors (encoders), in this order:
 *   left roller, left dial, right dial, right roller
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define CSP  0
#define CSP2 1

// Roller: zoom (Ctrl+- / Ctrl+=)
// Dial:   rotate (- / ')
#define CSP_SENSORS \
    sensor-bindings = < \
        &inc_dec_kp LC(MINUS) LC(EQUAL) \
        &inc_dec_kp MINUS SQT \
        &inc_dec_kp C_VOL_UP C_VOL_DN    /* right dial: unused */ \
        &inc_dec_kp C_VOL_UP C_VOL_DN    /* right roller: unused */ \
    >;

// Animation shortcuts: Ctrl+Alt+Shift+key (assign these in CSP Shortcut Settings)
#define ANIM(k) LC(LA(LS(k)))

// Layer 2 encoders
// Roller: zoom (same as layer 1)
// Dial:   previous frame / next frame
#define ANIM_SENSORS \
    sensor-bindings = < \
        &inc_dec_kp LC(MINUS) LC(EQUAL) \
        &inc_dec_kp ANIM(LBKT) ANIM(RBKT) \
        &inc_dec_kp C_VOL_UP C_VOL_DN    /* right dial: unused */ \
        &inc_dec_kp C_VOL_UP C_VOL_DN    /* right roller: unused */ \
    >;

/ {
    keymap {
        compatible = "zmk,keymap";

/* Layer 1: CSP
 * ,------------------------------------------------.
 * | Save   | Cut    | Copy   | Paste  | New raster |
 * |--------+--------+--------+--------+------------|
 * |Deselect|Select  | Pen    | Brush  | Flip canvas|
 * |--------+--------+--------+--------+------------|
 * |LAYER 2 |Swap col| C      |Brush - | Brush +    |
 * `------------------------------------------------'
 *  | Fit to screen | Redo | Space | Undo | Reset rotation |
 */
        csp_layer {
            display-name = "CSP";
            bindings = <
&kp LC(S)    &kp LC(X)    &kp LC(C)    &kp LC(V)    &kp LC(LS(N))      &none &none &none &none &none
&kp LC(D)    &kp M        &kp P        &kp B        &kp LC(LA(LS(H)))  &none &none &none &none &none
&tog CSP2    &kp X        &kp C        &kp LBKT     &kp RBKT           &none &none &none &none &none
&kp LC(N0)   &kp LC(Y)    &kp SPACE    &kp LC(Z)    &kp LC(LS(N1))     &none &none &none &none &none
            >;
            CSP_SENSORS
        };

/* Layer 2: ANIMATION  (*) = same as layer 1
 * ,------------------------------------------------------------.
 * | Play/pause | To start   | Prev draw  | Next draw  | New cel    |
 * |------------+------------+------------+------------+------------|
 * | Onion skin | Light table| Pen (*)    | Brush (*)  | Flip (*)   |
 * |------------+------------+------------+------------+------------|
 * | LAYER 1    | Add frame  | Remove frm | Brush - (*)| Brush + (*)|
 * `------------------------------------------------------------'
 *  | Fit (*) | Redo (*) | Space (*) | Undo (*) | Timeline |
 * Dial = previous / next frame. Roller = zoom.
 */
        anim_layer {
            display-name = "ANIM";
            bindings = <
&kp ANIM(P)      &kp ANIM(S)      &kp ANIM(COMMA)  &kp ANIM(DOT)    &kp ANIM(N)        &none &none &none &none &none
&kp ANIM(O)      &kp ANIM(L)      &trans           &trans           &trans             &none &none &none &none &none
&tog CSP2        &kp ANIM(EQUAL)  &kp ANIM(MINUS)  &trans           &trans             &none &none &none &none &none
&trans           &trans           &trans           &trans           &kp ANIM(T)        &none &none &none &none &none
            >;
            ANIM_SENSORS
        };
    };
};
